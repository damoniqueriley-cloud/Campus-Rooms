@host = https://localhost:7311
# If you run the app with the "http" profile instead, use:
# @host = http://localhost:5311

### 1. Every room as JSON. Expect 200 with five rooms.
GET {{host}}/api/rooms

### 2. One room. Expect 200, SB-110 with buildingName Science Block.
GET {{host}}/api/rooms/3

### 3. A room that doesn't exist. Expect 404.
GET {{host}}/api/rooms/99

### 4. Add a room. Expect 201 with a Location header and the room as JSON.
POST {{host}}/api/rooms
Content-Type: application/json

{
  "code": "MB-310",
  "name": "Lecture Theatre B",
  "seats": 80,
  "hasProjector": true,
  "buildingId": 1
}

### 5. The same POST again (same code MB-310). Expect 409.
POST {{host}}/api/rooms
Content-Type: application/json

{
  "code": "MB-310",
  "name": "Lecture Theatre B",
  "seats": 80,
  "hasProjector": true,
  "buildingId": 1
}

### 6. An empty code and 0 seats. Expect 400 with both messages.
POST {{host}}/api/rooms
Content-Type: application/json

{
  "code": "",
  "name": "Broken Room",
  "seats": 0,
  "hasProjector": false,
  "buildingId": 1
}

### 7. A correct body with no Content-Type line. Expect 415.
POST {{host}}/api/rooms

{
  "code": "MB-404",
  "name": "Missing Content Type",
  "seats": 10,
  "hasProjector": false,
  "buildingId": 1
}

### 8. Change room 2: the same details, but 32 seats. Expect 204.
PUT {{host}}/api/rooms/2
Content-Type: application/json

{
  "code": "MB-204",
  "name": "Seminar Room",
  "seats": 32,
  "hasProjector": false,
  "buildingId": 2
}

### 9. Room 2 with room 1's code. Expect 409.
PUT {{host}}/api/rooms/2
Content-Type: application/json

{
  "code": "MB-101",
  "name": "Seminar Room",
  "seats": 32,
  "hasProjector": false,
  "buildingId": 2
}

### 10. Change a room that doesn't exist. Expect 404.
PUT {{host}}/api/rooms/99
Content-Type: application/json

{
  "code": "ZZ-999",
  "name": "Ghost Room",
  "seats": 12,
  "hasProjector": false,
  "buildingId": 1
}

### 11. Delete room 5. Expect 204.
DELETE {{host}}/api/rooms/5

### 12. Delete room 5 again. Expect 404.
DELETE {{host}}/api/rooms/5
