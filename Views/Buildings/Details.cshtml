@model Building

<h1>@Model.Name</h1>

@if (Model.Rooms.Count == 0)
{
    <p>No rooms in @Model.Name yet.</p>
}
else
{
    <p>@Model.Rooms.Count rooms</p>
    <table class="table">
        <tr>
            <th>Code</th>
            <th>Name</th>
            <th>Seats</th>
            <th>Projector</th>
        </tr>
        @foreach (Room each_room in Model.Rooms.OrderBy(room => room.Code))
        {
            <tr>
                <td><a asp-controller="Rooms" asp-action="Details" asp-route-id="@each_room.Id">@each_room.Code</a></td>
                <td>@each_room.Name</td>
                <td>@each_room.Seats</td>
                <td>
                    @if (each_room.HasProjector)
                    {
                        <span class="badge bg-success">Projector</span>
                    }
                    else
                    {
                        <span class="text-muted">none</span>
                    }
                </td>
            </tr>
        }
    </table>
}

<a asp-controller="Buildings" asp-action="Index">All buildings</a>
