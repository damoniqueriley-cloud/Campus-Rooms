@model List<IdentityUser>

@using Microsoft.AspNetCore.Identity

<h1>Users</h1>
<p>Every account, by email. Only the Admin sees this page.</p>

<table class="table">
    <tr>
        <th>Email</th>
        <th>Role</th>
    </tr>
    @foreach (IdentityUser each_user in Model)
    {
        <tr>
            <td>@each_user.Email</td>
            <td>
                @{
                    bool is_admin = ViewBag.IsAdmin[each_user.Id];
                    bool is_staff = ViewBag.IsStaff[each_user.Id];
                }
                @if (is_admin)
                {
                    <span class="badge bg-dark">Admin</span>
                }
                @if (is_staff)
                {
                    <span class="badge bg-success">Staff</span>
                }
                else
                {
                    @* A POST, because it changes data *@
                    <form method="post" asp-controller="Users" asp-action="MakeStaff" asp-route-id="@each_user.Id" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-primary">Make staff</button>
                    </form>
                }
            </td>
        </tr>
    }
</table>
