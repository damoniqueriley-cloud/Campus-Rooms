@model Room

@{
    // Changing rooms needs Admin or Staff; deleting needs Admin.
    // Hiding a link is not the lock: the lock is on the action (Task 6).
    bool can_manage = User.IsInRole("Admin") || User.IsInRole("Staff");
}

<tr>
    <td><a asp-controller="Rooms" asp-action="Details" asp-route-id="@Model.Id">@Model.Code</a></td>
    <td>@Model.Name</td>
    <td>@Model.Seats</td>
    <td>
        @if (Model.HasProjector)
        {
            <span class="badge bg-success">Projector</span>
        }
        else
        {
            <span class="text-muted">none</span>
        }
    </td>
    <td>
        @if (Model.Building != null)
        {
            <a asp-controller="Buildings" asp-action="Details" asp-route-id="@Model.BuildingId">@Model.Building.Name</a>
        }
    </td>
    <td>
        @if (can_manage)
        {
            <a asp-controller="Rooms" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        }
        @if (User.IsInRole("Admin"))
        {
            <a class="text-danger ms-2" asp-controller="Rooms" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
        }
    </td>
</tr>
